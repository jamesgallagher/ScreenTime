# Copy to /mnt/user/appdata/screentime/.env on the Unraid server (docs/guides/deploy.md). Never commit the real one.

# The database password. Make one with:  openssl rand -base64 33 | tr -d '/+='
POSTGRES_PASSWORD=change-me

# Signs sign-in tokens. At least 32 random characters. Make one with:  openssl rand -base64 48 | tr -d '/+='
JWT_SECRET=change-me

# Signing in with this email gives the super admin role (docs/SPEC.md §6.2): it creates the family.
SUPER_ADMIN_EMAIL=

# Brevo SMTP relay (docs/SPEC.md §11.1): sign-in codes are emailed. SMTP_PASS is the Brevo SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@gallagherhome.au
SMTP_FROM_NAME=ScreenTime App

# Firebase Cloud Messaging: the service account key of project screentime-d307c as ONE line of JSON in single quotes.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Which image to run: latest, or a commit (ghcr.io/jamesgallagher/screentime-server:<sha>) to go back to.
API_TAG=latest
