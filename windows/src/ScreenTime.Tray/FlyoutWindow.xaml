<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenTime.Tray.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Screen Time">

    <!-- docs/SPEC.md §16.3: 360 × 440, Mica, anchored above the tray. Three panels share the window: the main one,
         Ask for more time and Message (the same options as Android, §16.2). -->
    <Grid x:Name="Root" Padding="24,20,24,14">
        <Grid.Resources>
            <Storyboard x:Name="Pulse" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="WaitingDot" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.9" />
            </Storyboard>
        </Grid.Resources>

        <!-- Main panel -->
        <Grid x:Name="MainPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Text="Screen Time" />
                <TextBlock x:Name="BigText" FontSize="40" FontWeight="SemiBold" Margin="0,4,0,0" Text="–" />
                <TextBlock x:Name="CaptionText" FontSize="14" Foreground="{ThemeResource StMutedBrush}" Text="Waiting for the service" />
                <ProgressBar x:Name="Bar" Height="8" MinHeight="8" CornerRadius="4" Maximum="1" Value="0" Margin="0,16,0,0"
                             Background="{ThemeResource StOutlineBrush}" />
                <TextBlock x:Name="SublineText" FontSize="14" Margin="0,10,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="8">
                <StackPanel x:Name="WaitingRow" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                    <Ellipse x:Name="WaitingDot" Width="10" Height="10" Fill="{ThemeResource StPlentyBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="WaitingText" FontSize="14" />
                </StackPanel>
                <Border x:Name="AnswerCard" CornerRadius="12" Padding="14,10" Visibility="Collapsed">
                    <TextBlock x:Name="AnswerText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,10">
                <Button x:Name="AskButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="40" CornerRadius="20"
                        Content="Ask for more time" IsEnabled="False" Click="OnAsk" />
                <Button x:Name="MessageButton" HorizontalAlignment="Stretch" MinHeight="40" CornerRadius="20"
                        Content="Message your parents" IsEnabled="False" Click="OnMessage" />
                <HyperlinkButton x:Name="ParentButton" Content="I'm the parent" Padding="0,6" Margin="0,4,0,0" IsEnabled="False" />
            </StackPanel>

            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource StOutlineBrush}" Padding="0,10,0,0">
                <TextBlock x:Name="SyncedText" FontSize="12" Foreground="{ThemeResource StMutedBrush}" Text="Not synced yet" />
            </Border>
        </Grid>

        <!-- Ask for more time -->
        <Grid x:Name="AskPanel" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnBack" Padding="6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock Text="How much more?" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="Chip15" Grid.Column="0" Content="15 min" Tag="15" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="24" IsChecked="True" Click="OnChip" />
                <ToggleButton x:Name="Chip30" Grid.Column="1" Content="30 min" Tag="30" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="24" Click="OnChip" />
                <ToggleButton x:Name="Chip60" Grid.Column="2" Content="1 hour" Tag="60" HorizontalAlignment="Stretch" MinHeight="48" CornerRadius="24" Click="OnChip" />
            </Grid>
            <StackPanel Grid.Row="2" Spacing="4">
                <TextBox x:Name="ReasonBox" PlaceholderText="Why? (optional)" MaxLength="160" TextWrapping="Wrap" AcceptsReturn="False" Height="88"
                         TextChanged="OnReasonChanged" />
                <TextBlock x:Name="ReasonCount" Text="0/160" FontSize="12" Foreground="{ThemeResource StMutedBrush}" HorizontalAlignment="Right" />
            </StackPanel>
            <TextBlock x:Name="AskError" Grid.Row="3" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource StCriticalBrush}" Visibility="Collapsed" />
            <Button x:Name="AskSend" Grid.Row="4" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="44" CornerRadius="22"
                    Content="Send" Margin="0,0,0,6" Click="OnAskSend" />
        </Grid>

        <!-- Message Mum and Dad -->
        <Grid x:Name="MessagePanel" Visibility="Collapsed" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="OnBack" Padding="6" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <TextBlock x:Name="MessageTitle" Text="Message your parents" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PresetList" Spacing="6" />
            </ScrollViewer>
            <StackPanel Grid.Row="2" Spacing="4">
                <TextBox x:Name="OwnBox" PlaceholderText="Or write your own" MaxLength="160" TextWrapping="Wrap" AcceptsReturn="False" Height="64"
                         TextChanged="OnOwnChanged" />
                <TextBlock x:Name="OwnCount" Text="0/160" FontSize="12" Foreground="{ThemeResource StMutedBrush}" HorizontalAlignment="Right" />
            </StackPanel>
            <TextBlock x:Name="MessageError" Grid.Row="3" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource StCriticalBrush}" Visibility="Collapsed" />
            <Button x:Name="MessageSend" Grid.Row="4" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="44" CornerRadius="22"
                    Content="Send" IsEnabled="False" Margin="0,0,0,6" Click="OnMessageSend" />
        </Grid>
    </Grid>
</Window>
